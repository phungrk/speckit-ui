# Server-side only. Without a key, Copilot answers from a built-in offline responder.
ANTHROPIC_API_KEY=
# Optional overrides
COPILOT_MODEL=claude-opus-5-5
PORT=8787

# Read a real Spec Kit project from GitHub (server-side only). Leave GITHUB_REPO empty for the demo data.
GITHUB_REPO=
# Branch or tag to read; defaults to the repository's default branch.
GITHUB_REF=
# Fine-grained token. Root repo: Contents read, Pull requests read, Issues read+write (gate approvals).
# Submodule repos: Contents read, Pull requests read. See README → GitHub mode.
GITHUB_TOKEN=
