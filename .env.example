# Copy to .env (shared settings) and put personal tokens in .env.local, which git ignores.
# .env.local overrides .env for both `npm run dev` and `npm start`.

# Server-side only. Without a key, Copilot answers from a built-in offline responder.
ANTHROPIC_API_KEY=
# Optional overrides
COPILOT_MODEL=claude-opus-5-5
PORT=8787

# Repository opened first when the URL names none. Users can switch to any repo their own access allows.
GITHUB_REPO=
# Branch or tag to read in GITHUB_REPO; defaults to the repository's default branch.
GITHUB_REF=

# Local (token) mode: your own fine-grained token. Put it in .env.local, never in .env.
# Repos: Contents read, Pull requests read, Issues read+write (gate approvals). See README → GitHub mode.
# In token mode the server only listens on 127.0.0.1.
GITHUB_TOKEN=
# Set to 1 to let a token-mode server listen beyond 127.0.0.1. Everyone who can reach it acts as you.
ALLOW_REMOTE_TOKEN_MODE=

# Sign-in mode (servers shared by a team): a GitHub App with user access tokens.
# When both are set, everyone signs in with GitHub and works with their own access; GITHUB_TOKEN is ignored.
# Callback URL to register on the App: <PUBLIC_URL>/auth/callback
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Public origin of the server, e.g. https://speckit.example.com. Defaults to the request's host.
PUBLIC_URL=
