{
  "name": "speckit-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.hook.config.ts",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build:pages": "VITE_STATIC=1 VITE_BASE=/speckit-ui/ npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
